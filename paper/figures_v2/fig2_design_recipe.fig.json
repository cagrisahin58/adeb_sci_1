  },
  "denge_muafiyet": {
    "karakter_cm2": "the figure replaces Table 1 of the paper; each cell's training settings are its content and every value is read from the recipe file",
    "yazi_kutusu_alani": "the settings of five cells and the shared adversarial recipe are text by nature; the 8 pt floor fixes their line boxes"
  },
